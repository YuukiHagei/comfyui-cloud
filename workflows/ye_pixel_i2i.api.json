  "7": { "class_type": "CLIPTextEncode", "inputs": { "text": "blurry, smooth gradient, photorealistic, 3d render, noise, text, watermark, deformed", "clip": ["2", 1] } },
  "8": { "class_type": "KSampler", "inputs": { "model": ["2", 0], "seed": 424242, "steps": 30, "cfg": 7, "sampler_name": "euler", "scheduler": "karras", "positive": ["6", 0], "negative": ["7", 0], "latent_image": ["5", 0], "denoise": 0.55 } },
  "9": { "class_type": "VAEDecode", "inputs": { "samples": ["8", 0], "vae": ["1", 2] } },
